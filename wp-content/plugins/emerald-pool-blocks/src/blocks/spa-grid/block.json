{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "emerald-pool/spa-grid",
	"title": "Spa grid",
	"category": "emerald-pool",
	"icon": "grid-view",
	"description": "A server-rendered grid of spas from the catalogue, filtered by type and series. Optional chips let a visitor narrow the grid without a page reload.",
	"keywords": [ "spa", "products", "hot tub", "grid", "catalogue" ],
	"textdomain": "emerald-pool-blocks",
	"attributes": {
		"spaType": { "type": "string", "default": "" },
		"series": { "type": "string", "default": "" },
		"numberOfItems": { "type": "number", "default": 6 },
		"columns": { "type": "number", "default": 3 },
		"orderBy": { "type": "string", "enum": [ "menu_order", "title", "date" ], "default": "menu_order" },
		"showFilters": { "type": "boolean", "default": false },
		"showPrice": { "type": "boolean", "default": true },
		"excludeCurrent": { "type": "boolean", "default": false }
	},
	"usesContext": [ "postId" ],
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": { "padding": true, "margin": [ "top", "bottom" ] },
		"interactivity": true
	},
	"example": {
		"attributes": { "numberOfItems": 3, "columns": 3, "showFilters": false }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "file:./style-index.css", "emerald-pool-shared" ],
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
