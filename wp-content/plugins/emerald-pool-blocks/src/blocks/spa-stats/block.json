{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "emerald-pool/spa-stats",
	"title": "Stat column",
	"category": "emerald-pool",
	"icon": "chart-bar",
	"description": "Four figures about the business, held against a sticky heading as they scroll past. Each number counts up once, the first time it is seen.",
	"keywords": [ "stats", "numbers", "figures", "about" ],
	"textdomain": "emerald-pool-blocks",
	"attributes": {
		"heading": { "type": "string", "default": "" },
		"standfirst": { "type": "string", "default": "" },
		"items": {
			"type": "array",
			"default": [],
			"items": { "type": "object" }
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": { "padding": true, "margin": [ "top", "bottom" ] },
		"interactivity": true
	},
	"example": {
		"attributes": {
			"heading": "Seventy years of the same job",
			"items": [
				{ "value": 1955, "label": "Trading since", "format": "plain" },
				{ "value": 2, "label": "Showrooms, both with water in them" },
				{ "value": 11000, "label": "Spas delivered", "prefix": "over " }
			]
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [ "file:./style-index.css", "emerald-pool-shared" ],
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
