{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "emerald-pool/spa-hero",
	"title": "Hero",
	"category": "emerald-pool",
	"icon": "cover-image",
	"description": "A full-viewport opening statement: background image or muted video, scrim, eyebrow, heading, standfirst, buttons, and a utility row pinned to the bottom of the frame.",
	"keywords": [
		"hero",
		"banner",
		"header",
		"cover"
	],
	"textdomain": "emerald-pool-blocks",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"standfirst": {
			"type": "string",
			"default": ""
		},
		"headingLevel": {
			"type": "number",
			"default": 1
		},
		"mediaId": {
			"type": "number"
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"focalPoint": {
			"type": "object",
			"default": {
				"x": 0.5,
				"y": 0.5
			}
		},
		"overlayOpacity": {
			"type": "number",
			"default": 62
		},
		"minHeight": {
			"type": "number",
			"default": 92
		},
		"contentAlign": {
			"type": "string",
			"enum": [
				"left",
				"center"
			],
			"default": "left"
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"metaHeading": {
			"type": "string",
			"default": ""
		},
		"metaBody": {
			"type": "string",
			"default": ""
		},
		"showScrollCue": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"spacing": {
			"padding": true,
			"margin": [
				"top",
				"bottom"
			]
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"example": {
		"attributes": {
			"eyebrow": "Eugene &amp; Bend, Oregon",
			"heading": "Warm water is a winter plan",
			"standfirst": "Three generations of getting Oregon backyards right.",
			"metaHeading": "Two showrooms",
			"metaBody": "Eugene · Mon–Sat 9–6\nBend · Mon–Fri 9–6",
			"overlayOpacity": 62,
			"minHeight": 40
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
