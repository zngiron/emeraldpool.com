{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "emerald-pool/spa-comparison",
  "title": "Spa comparison",
  "category": "emerald-pool",
  "icon": "columns",
  "description": "Puts two or three spas side by side in one table so a shopper can see the difference without opening tabs.",
  "keywords": [
    "compare",
    "comparison",
    "table",
    "spa"
  ],
  "textdomain": "emerald-pool-blocks",
  "attributes": {
    "postIds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    },
    "showImages": {
      "type": "boolean",
      "default": true
    },
    "caption": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "spacing": {
      "padding": true,
      "margin": [
        "top",
        "bottom"
      ]
    },
    "interactivity": {
      "clientNavigation": true
    }
  },
  "example": {
    "attributes": {
      "postIds": [],
      "showImages": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "file:./style-index.css",
    "emerald-pool-shared"
  ],
  "render": "file:./render.php"
}