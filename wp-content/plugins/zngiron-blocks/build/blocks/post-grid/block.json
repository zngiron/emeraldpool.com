{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zngiron/post-grid",
  "title": "Post Grid",
  "category": "zngiron",
  "icon": "screenoptions",
  "description": "A query over any post type, rendered as Cards, with optional filter chips that narrow the grid in the browser.",
  "keywords": [
    "query",
    "posts",
    "loop",
    "grid"
  ],
  "textdomain": "zngiron-blocks",
  "attributes": {
    "postType": {
      "type": "string",
      "default": ""
    },
    "taxonomy": {
      "type": "string",
      "default": ""
    },
    "term": {
      "type": "string",
      "default": ""
    },
    "count": {
      "type": "number",
      "default": 6
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "orderBy": {
      "type": "string",
      "default": "menu_order"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "showFilters": {
      "type": "boolean",
      "default": false
    },
    "filterTaxonomy": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "padding": true,
      "margin": [
        "top",
        "bottom"
      ]
    },
    "interactivity": true
  },
  "example": {
    "attributes": {
      "count": 3,
      "columns": 3
    }
  },
  "editorScript": "file:./index.js",
  "style": [
    "file:./style-index.css",
    "zngiron-frame"
  ],
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}