{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zngiron/specs-table",
  "title": "Specs Table",
  "category": "zngiron",
  "icon": "editor-table",
  "description": "Key and value rows built from the meta fields declared in config/brand.json for the post being viewed.",
  "keywords": [ "specs", "specifications", "table", "meta" ],
  "textdomain": "zngiron-blocks",
  "usesContext": [ "postId", "postType" ],
  "attributes": {
    "heading": { "type": "string", "default": "" },
    "postId": { "type": "number", "default": 0 }
  },
  "supports": {
    "anchor": true,
    "align": [ "wide" ],
    "html": false,
    "color": { "text": true, "background": true },
    "spacing": { "padding": true, "margin": [ "top", "bottom" ] }
  },
  "example": {
    "attributes": { "heading": "Specifications" }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
