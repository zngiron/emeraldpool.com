.env
node_modules/
build/
.DS_Store

# WordPress core drops its bundled themes/plugins into the bind mounts.
# Ignore everything under them, then whitelist our own code.
wp-content/uploads/
wp-content/themes/*
wp-content/plugins/*
!wp-content/themes/zngiron-base/
!wp-content/plugins/zngiron-blocks/

# The compiled blocks ARE committed: deployment must not need Node.
!wp-content/plugins/zngiron-blocks/build/

# Screenshot runs. docs/screenshots/ holds the curated selection.
.shots/
